# ── Pinkha — CD pipelines ─────────────────────────────────────────────────
#
# Two lanes :
#   • `beta`    — builds from `staging` and uploads to TestFlight.
#   • `release` — builds from `master` and stages an App Store submission.
#
# Both are invoked locally (`bundle exec fastlane ios beta`) or from
# GitHub Actions. The actions/secrets surface the same ENV variables in
# both contexts so the lanes are environment-agnostic.

# Suppress fastlane's noisy auto-update prompts.
opt_out_usage
update_fastlane(no_update: true) if respond_to?(:update_fastlane)

# Shared lane prefix so commands look like `fastlane ios beta`.
platform :ios do

  # ── Setup helpers ────────────────────────────────────────────────────

  # Centralised ASC API key loader — every lane needs it, factoring it
  # avoids drift between the two upload paths.
  def load_asc_api_key
    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID"),
      # The content can be either the raw .p8 text OR a base64-encoded
      # blob — base64 is friendlier for GitHub Secrets which strip
      # newlines from multi-line values.
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_CONTENT"),
      is_key_content_base64: ENV.fetch("APP_STORE_CONNECT_API_KEY_BASE64", "true") == "true",
      in_house: false,
    )
  end

  # Creates a fresh, unlocked keychain named after
  # MATCH_KEYCHAIN_NAME on CI runners that don't already have one
  # (GitHub Actions macos-14 runners start with only the login
  # keychain). No-op on a developer Mac, where the keychain
  # already exists and the env var is typically unset.
  def setup_ci_keychain_if_needed
    keychain_name = ENV["MATCH_KEYCHAIN_NAME"]
    return if keychain_name.nil? || keychain_name.empty?
    keychain_path = File.expand_path(
      "~/Library/Keychains/#{keychain_name}-db"
    )
    return if File.exist?(keychain_path)
    create_keychain(
      name: keychain_name,
      password: ENV.fetch("MATCH_KEYCHAIN_PASSWORD", ""),
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false,
    )
  end

  # Build number = (latest TestFlight build number, all trains
  # included) + 1. This guarantees a monotonically increasing
  # build number even if you submit to App Store separately from
  # TestFlight ; both surfaces share the same numbering space.
  def bump_build_number
    next_number = latest_testflight_build_number(
      api_key: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY],
      initial_build_number: 0,
    ) + 1
    # `xcodeproj:` is required because the project lives at
    # `app/Pinkha.xcodeproj`, not at the repo root. Without it
    # increment_build_number falls back to agvtool which can't
    # find any .xcodeproj in the cwd and fails.
    increment_build_number(
      build_number: next_number,
      xcodeproj: "app/Pinkha.xcodeproj",
    )
    next_number
  end

  # ── Lane : bootstrap_match ───────────────────────────────────────────
  #
  # First-time setup. Run this ONCE locally on a Mac to mint the App
  # Store distribution certificate + provisioning profile and push
  # them (encrypted with MATCH_PASSWORD) into the pinkha-app/certificates
  # repo. Subsequent runs of `match(readonly: true)` from beta/release
  # lanes will fetch them rather than create new ones.
  #
  # Why a dedicated lane : the bare `fastlane match` CLI invocation
  # doesn't go through the Fastfile, so it never loads the ASC API
  # key — and falls back to interactive Apple ID login which doesn't
  # work in non-interactive shells (CI, scripted runs).
  desc "First-time setup : create App Store cert + profile and push to certificates repo."
  lane :bootstrap_match do
    load_asc_api_key
    # readonly: false = allow match to create the cert/profile if
    # they don't exist yet. Only safe for this one-time bootstrap.
    match(type: "appstore", readonly: false)
  end

  # ── Lane : beta ──────────────────────────────────────────────────────

  desc "Builds the staging branch and uploads to TestFlight."
  lane :beta do
    # Soft guard : refuse to run from a stray branch by accident.
    # `skip_if_branch_check` env var lets the CI runner override
    # (GitHub Actions checks out a detached HEAD, not the branch name).
    ensure_git_branch(branch: "staging") unless ENV["SKIP_BRANCH_CHECK"]

    load_asc_api_key
    setup_ci_keychain_if_needed

    # `readonly: true` makes match fail loudly if a cert or profile
    # is missing instead of silently creating new ones. On CI we
    # want explicit "go run bootstrap" rather than mysterious extra
    # certs polluting the developer portal.
    match(type: "appstore", readonly: true)

    bump_build_number

    build_app(
      project: "app/Pinkha.xcodeproj",
      scheme: "Pinkha",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build/",
      output_name: "Pinkha.ipa",
      clean: true,
      include_symbols: true,
      include_bitcode: false,
    )

    upload_to_testflight(
      api_key: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY],
      # Don't block the CI runner on Apple's processing pipeline
      # (which can take 30+ minutes). The build shows up in
      # TestFlight whenever Apple finishes ; testers get notified.
      skip_waiting_for_build_processing: true,
      # Inherit "What to Test" from the changelog file so we don't
      # have to edit the Fastfile each cycle. Keep the file ASCII
      # to dodge encoding surprises.
      changelog: File.exist?("changelog.txt") ? File.read("changelog.txt") : "Pinkha staging build.",
    )
  end

  # ── Lane : release ───────────────────────────────────────────────────

  desc "Builds the master branch and stages an App Store submission."
  lane :release do
    ensure_git_branch(branch: "master") unless ENV["SKIP_BRANCH_CHECK"]

    load_asc_api_key
    setup_ci_keychain_if_needed

    match(type: "appstore", readonly: true)

    bump_build_number

    build_app(
      project: "app/Pinkha.xcodeproj",
      scheme: "Pinkha",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build/",
      output_name: "Pinkha.ipa",
      clean: true,
      include_symbols: true,
      include_bitcode: false,
    )

    # Upload but don't submit for review yet — gives you a manual
    # checkpoint in App Store Connect to fill in release notes,
    # screenshots, etc. before clicking "Submit for Review".
    upload_to_app_store(
      api_key: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY],
      submit_for_review: false,
      automatic_release: false,
      force: true,
      skip_metadata: true,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
    )
  end
end
