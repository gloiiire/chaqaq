# ── Pinkha fastlane env ───────────────────────────────────────────────
#
# Copy to `.env` (same folder) and fill the values for local runs.
# CI gets the same names from GitHub Secrets — never commit `.env`.

# App Store Connect API key (generated in ASC → Users and Access →
# Integrations → App Store Connect API).
APP_STORE_CONNECT_API_KEY_ID=
APP_STORE_CONNECT_API_ISSUER_ID=

# The .p8 file content. Two formats supported :
#   - Raw multi-line text :       APP_STORE_CONNECT_API_KEY_BASE64=false
#   - Base64-encoded single line : APP_STORE_CONNECT_API_KEY_BASE64=true
# Base64 is the simpler shape for GitHub Secrets (no multi-line escape).
APP_STORE_CONNECT_API_KEY_CONTENT=
APP_STORE_CONNECT_API_KEY_BASE64=true

# Password chosen during `fastlane match init`. Encrypts the certs
# stored in the pinkha-app/certificates repo. Treat it like a vault
# master password.
MATCH_PASSWORD=

# Personal access token (or fine-grained token) with `contents: read`
# scope on pinkha-app/certificates. Only required in CI ; locally
# match uses your SSH key / git credentials.
# Format expected by match : `username:token` then base64-encoded.
# MATCH_GIT_BASIC_AUTHORIZATION=
