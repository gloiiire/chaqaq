namespace pinkha {};

// ── Erreurs ───────────────────────────────────────────────────────────────────

[Error]
interface PinkhaError {
    NotFound(string id);
    InvalidOperation(string detail);
    Storage(string detail);
};

// ── Types retournés ───────────────────────────────────────────────────────────

/// Métadonnées légères d'un document (sans blocs).
dictionary DocumentMetaFfi {
    string id;
    string title_plain;
    string title_json;
    string? cover;
    string updated_at;
    string created_at;
};

/// Métadonnées légères d'une database (sans entrées).
dictionary DatabaseMetaFfi {
    string id;
    string title_plain;
    string title_json;
    string updated_at;
    string created_at;
};

/// Résumé d'une opération d'import retourné à Swift.
dictionary ImportResultFfi {
    string app;
    string database_id;
    u32 documents;
    u32 entries;
    u32 blocks;
    u32 skipped;
};

// ── Façade principale ─────────────────────────────────────────────────────────

interface PinkhaApi {
    /// Ouvre (ou crée) la base SQLite au chemin donné.
    [Throws=PinkhaError]
    constructor(string db_path);

    // ── Documents ─────────────────────────────────────────────

    /// Crée un nouveau document et retourne son UUID.
    [Throws=PinkhaError]
    string create_document(string title);

    /// Retourne le document complet sérialisé en JSON (avec blocs).
    [Throws=PinkhaError]
    string get_document_json(string id);

    /// Liste les métadonnées de tous les documents actifs.
    [Throws=PinkhaError]
    sequence<DocumentMetaFfi> list_documents();

    /// Soft-delete du document.
    [Throws=PinkhaError]
    void delete_document(string id);

    /// Soft-delete de tous les documents. Retourne le nombre supprimé.
    [Throws=PinkhaError]
    u32 delete_all_documents();

    [Throws=PinkhaError]
    void update_document_title(string id, string new_title);

    [Throws=PinkhaError]
    void update_document_cover(string id, string? cover);

    /// Ajoute un bloc ; le contenu est passé en JSON (BlockContent sérialisé).
    /// Retourne le document mis à jour en JSON.
    [Throws=PinkhaError]
    string add_block(string doc_id, string block_content_json);

    /// Remplace le contenu d'un bloc existant (JSON de BlockContent).
    [Throws=PinkhaError]
    void update_block(string doc_id, string block_id, string content_json);

    [Throws=PinkhaError]
    void delete_block(string doc_id, string block_id);

    /// Réordonne les blocs racine selon la liste d'UUIDs fournie.
    [Throws=PinkhaError]
    void reorder_blocks(string doc_id, sequence<string> order);

    /// Ajoute un bloc enfant ; le contenu est passé en JSON (BlockContent sérialisé).
    [Throws=PinkhaError]
    string add_child_block(string doc_id, string parent_id, string block_content_json);

    /// Réordonne les enfants directs d'un bloc parent.
    [Throws=PinkhaError]
    void reorder_child_blocks(string doc_id, string parent_id, sequence<string> order);

    /// Déplace un bloc vers un parent ou vers la racine si `new_parent_id` est nul.
    [Throws=PinkhaError]
    void move_block(string doc_id, string block_id, string? new_parent_id);

    /// Recherche insensible à la casse dans les titles.
    [Throws=PinkhaError]
    sequence<DocumentMetaFfi> search_documents(string query);

    /// Recherche plein texte dans les blocs.
    [Throws=PinkhaError]
    sequence<DocumentMetaFfi> search_in_blocks(string query);

    // ── Databases ─────────────────────────────────────────────

    /// Crée une nouvelle database et retourne son UUID.
    [Throws=PinkhaError]
    string create_database(string title);

    /// Retourne la database complète sérialisée en JSON (avec entrées et vues).
    [Throws=PinkhaError]
    string get_database_json(string id);

    /// Liste les métadonnées de toutes les databases actives.
    [Throws=PinkhaError]
    sequence<DatabaseMetaFfi> list_databases();

    /// Soft-delete de la database.
    [Throws=PinkhaError]
    void delete_database(string id);

    /// Ajoute une entrée ; `values_json` est une map UUID -> ValeurPropriete sérialisée.
    [Throws=PinkhaError]
    string add_entry(string db_id, string values_json);

    [Throws=PinkhaError]
    void update_entry(string db_id, string entry_id, string values_json);

    [Throws=PinkhaError]
    void delete_entry(string db_id, string entry_id);

    /// Ajoute une propriété sérialisée en JSON.
    [Throws=PinkhaError]
    void add_property(string db_id, string property_json);

    [Throws=PinkhaError]
    void rename_property(string db_id, string property_id, string new_name);

    [Throws=PinkhaError]
    void delete_property(string db_id, string property_id);

    /// Ajoute une vue sérialisée en JSON.
    [Throws=PinkhaError]
    string add_view(string db_id, string view_json);

    [Throws=PinkhaError]
    void update_view(string db_id, string view_id, string filters_json, string sorts_json);

    [Throws=PinkhaError]
    void delete_view(string db_id, string view_id);

    /// Retourne les entrées filtrées/triées en JSON.
    [Throws=PinkhaError]
    string query_database_json(string db_id, string view_id);

    /// Retourne les entrées filtrées/triées avec rollups calculés en JSON.
    [Throws=PinkhaError]
    string query_database_with_rollups_json(string db_id, string view_id);

    /// Retourne les groupes d'entrées en JSON.
    [Throws=PinkhaError]
    string grouped_query_database_json(string db_id, string view_id, string group_by);

    /// Retourne l'agrégat d'une colonne en JSON.
    [Throws=PinkhaError]
    string column_aggregate_database_json(string db_id, string property_id, string aggregate_json);

    /// Retourne les entrées correspondant à la recherche en JSON.
    [Throws=PinkhaError]
    string search_database_entries_json(string db_id, string query);

    // ── Imports ───────────────────────────────────────────────

    /// Importe une database Notion complète (schéma + pages + blocs).
    /// `token` est un bearer token OAuth2 ou private integration token.
    /// `database_id` est un UUID 32-char hex ou l'URL complète Notion.
    [Async, Throws=PinkhaError]
    ImportResultFfi import_from_notion(string token, string database_id);

    /// Importe les notes Bear depuis la SQLite locale de Bear.
    /// `db_path` est le chemin absolu vers `database.sqlite` de Bear.
    [Async, Throws=PinkhaError]
    ImportResultFfi import_from_bear(string db_path);

    /// Importe les pages Craft depuis le fichier `.realm` local de Craft.
    /// `db_path` est le chemin absolu vers le fichier `.realm` de Craft.
    [Async, Throws=PinkhaError]
    ImportResultFfi import_from_craft(string db_path);

    /// Importe les pages Craft depuis un dossier de `.textbundle` exporté par Craft.
    /// `root_dir` est le chemin absolu vers le dossier racine de l'export.
    [Async, Throws=PinkhaError]
    ImportResultFfi import_from_craft_textbundle(string root_dir);

    /// Combine le fichier `.realm` de Craft et un dossier de `.textbundle` :
    /// les pages ayant un textbundle correspondant utilisent son contenu markdown ;
    /// les autres pages utilisent le contenu realm.
    [Async, Throws=PinkhaError]
    ImportResultFfi import_from_craft_combined(string realm_path, string textbundle_root);
};
