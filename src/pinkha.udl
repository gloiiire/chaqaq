namespace pinkha {};

// ── Errors ────────────────────────────────────────────────────────────────────

[Error]
interface PinkhaError {
    NotFound(string id);
    InvalidOperation(string detail);
    Storage(string detail);
};

// ── Returned types ────────────────────────────────────────────────────────────

/// Lightweight document metadata (no blocks).
dictionary DocumentMetaFfi {
    string id;
    string title_plain;
    string title_json;
    string? cover;
    string updated_at;
    string created_at;
    string published_at;
    string? folder_id;
    string? parent_doc_id;
    string? icon;
};

/// Lightweight folder metadata.
dictionary FolderMetaFfi {
    string id;
    string name;
    string? parent_id;
    string created_at;
    string updated_at;
    string? icon;
};

/// Lightweight database metadata (no entries).
dictionary DatabaseMetaFfi {
    string id;
    string title_plain;
    string title_json;
    string? cover;
    string? icon;
    string updated_at;
    string created_at;
};

/// One hit from a block-content search — the document metadata plus a
/// snippet of the matching block for a Notion-style preview.
dictionary BlockSearchHitFfi {
    DocumentMetaFfi doc;
    string block_id;
    string snippet;
};

/// Bundle of search results across every workspace surface, returned by
/// `super_search`. Empty arrays mean "no match in that category".
dictionary SuperSearchResultsFfi {
    sequence<DocumentMetaFfi> documents_by_title;
    sequence<BlockSearchHitFfi> documents_by_content;
    sequence<DatabaseMetaFfi> databases;
    sequence<FolderMetaFfi> folders;
};

/// Summary of a completed import operation, returned to Swift.
dictionary ImportResultFfi {
    string app;
    string database_id;
    u32 documents;
    u32 entries;
    u32 blocks;
    u32 skipped;
    /// Combined importer only: pages imported via textbundle content (0 otherwise).
    u32 matched_textbundle;
    /// Combined importer only: realm pages with no matching textbundle (0 otherwise).
    u32 realm_fallback;
    /// Combined importer only: textbundles with no matching realm page (0 otherwise).
    u32 textbundle_only;
};

/// Summary of a Notion database returned by `list_notion_databases` for
/// the picker UI.
dictionary NotionDatabaseSummaryFfi {
    string id;
    string title;
    string? icon_emoji;
    string last_edited;
};

// ── Main facade ───────────────────────────────────────────────────────────────

interface PinkhaApi {
    /// Opens (or creates) the SQLite database at the given path.
    [Throws=PinkhaError]
    constructor(string db_path);

    // ── Documents ─────────────────────────────────────────────

    /// Creates a new document and returns its UUID.
    [Throws=PinkhaError]
    string create_document(string title);

    /// Returns the full document serialized as JSON (with blocks).
    [Throws=PinkhaError]
    string get_document_json(string id);

    /// Lists metadata for every active document.
    [Throws=PinkhaError]
    sequence<DocumentMetaFfi> list_documents();

    /// Soft-deletes the document.
    [Throws=PinkhaError]
    void delete_document(string id);

    /// Soft-deletes every document. Returns the number deleted.
    [Throws=PinkhaError]
    u32 delete_all_documents();

    [Throws=PinkhaError]
    void update_document_title(string id, string new_title);

    [Throws=PinkhaError]
    void update_document_cover(string id, string? cover);

    /// Sets or clears a document's icon (emoji, local filename, or URL).
    [Throws=PinkhaError]
    void update_document_icon(string id, string? icon);

    /// Enables or disables the read-only lock on a document.
    /// Imports (Notion/Bear/Craft) automatically call this with
    /// `locked = true` at creation time.
    [Throws=PinkhaError]
    void update_document_locked(string id, boolean locked);

    /// Overrides a document's published_at timestamp. Empty string =
    /// reset to the default (follows created_at).
    [Throws=PinkhaError]
    void update_document_published_at(string id, string new_published_at);

    /// Sets or clears the document's accent color (per-doc override of
    /// the global accent). Color name ("red", "teal"...) or null to
    /// fall back to the Settings accent.
    [Throws=PinkhaError]
    void update_document_accent_color(string id, string? accent_color);

    /// Appends a block; the content is passed as JSON (serialized BlockContent).
    /// Returns the updated document as JSON.
    [Throws=PinkhaError]
    string add_block(string doc_id, string block_content_json);

    /// Replaces the content of an existing block (BlockContent JSON).
    [Throws=PinkhaError]
    void update_block(string doc_id, string block_id, string content_json);

    /// Sets or clears a block's text color. `color` is a color name
    /// (`"red"`, `"blue"`, etc.) or `null` to revert to the theme.
    /// Inline colors on spans always take priority.
    [Throws=PinkhaError]
    void set_block_color(string doc_id, string block_id, string? color);

    /// Sets or clears the block's background color (Craft-style highlight).
    [Throws=PinkhaError]
    void set_block_background_color(string doc_id, string block_id, string? background_color);

    /// Sets or clears the block's writing direction ("ltr" / "rtl").
    /// `null` = inherit from the document.
    [Throws=PinkhaError]
    void set_block_text_direction(string doc_id, string block_id, string? text_direction);

    /// Sets or clears the document's default writing direction.
    /// `null` = system locale. Every block can override.
    [Throws=PinkhaError]
    void update_document_text_direction(string id, string? text_direction);

    /// Sets or clears the per-document theme.
    /// `null` = inherit from AppSettings.theme.
    [Throws=PinkhaError]
    void update_document_theme(string id, string? theme);

    [Throws=PinkhaError]
    void delete_block(string doc_id, string block_id);

    /// Duplicates a block (and all its children, with fresh UUIDs) and
    /// inserts the clone right after the original at the same level.
    /// Returns the new block's UUID.
    [Throws=PinkhaError]
    string duplicate_block(string doc_id, string block_id);

    /// Reorders the root blocks according to the supplied UUID list.
    [Throws=PinkhaError]
    void reorder_blocks(string doc_id, sequence<string> order);

    /// Appends a child block; the content is passed as JSON (serialized BlockContent).
    [Throws=PinkhaError]
    string add_child_block(string doc_id, string parent_id, string block_content_json);

    /// Reorders the direct children of a parent block.
    [Throws=PinkhaError]
    void reorder_child_blocks(string doc_id, string parent_id, sequence<string> order);

    /// Moves a block under a parent, or to the root when `new_parent_id` is null.
    [Throws=PinkhaError]
    void move_block(string doc_id, string block_id, string? new_parent_id);

    /// Indents a block: moves it under the previous sibling at the same level.
    /// `InvalidOperation` when the block is the first of its level.
    [Throws=PinkhaError]
    void indent_block(string doc_id, string block_id);

    /// Outdents a block: moves it out of its parent up to the grandparent
    /// level, right after the former parent. `InvalidOperation` when the
    /// block is already at the root.
    [Throws=PinkhaError]
    void outdent_block(string doc_id, string block_id);

    /// Case-insensitive search across document titles.
    [Throws=PinkhaError]
    sequence<DocumentMetaFfi> search_documents(string query);

    /// Full-text search across block content.
    [Throws=PinkhaError]
    sequence<DocumentMetaFfi> search_in_blocks(string query);

    /// Search across database titles.
    [Throws=PinkhaError]
    sequence<DatabaseMetaFfi> search_databases(string query);

    /// Full-text search returning a snippet of each matching block.
    [Throws=PinkhaError]
    sequence<BlockSearchHitFfi> search_in_blocks_with_snippets(string query);

    /// Search across folder names.
    [Throws=PinkhaError]
    sequence<FolderMetaFfi> search_folders(string query);

    /// Runs every search axis in one call (titles, block content with
    /// snippets, databases, folders) with the document axis deduplicated.
    [Throws=PinkhaError]
    SuperSearchResultsFfi super_search(string query);

    /// Lightweight metadata for a single document (no block tree).
    [Throws=PinkhaError]
    DocumentMetaFfi get_document_meta(string id);

    /// Lists trashed documents (soft-deleted), most recently deleted first.
    [Throws=PinkhaError]
    sequence<DocumentMetaFfi> list_deleted_documents();

    /// Restores a document from the trash.
    [Throws=PinkhaError]
    void restore_document(string id);

    /// Permanently deletes a document from the trash (hard delete).
    [Throws=PinkhaError]
    void purge_document(string id);

    /// Permanently purges every soft-deleted document, database and folder.
    /// Returns the total number of items removed.
    [Throws=PinkhaError]
    u32 empty_trash();

    // ── Databases ─────────────────────────────────────────────

    /// Creates a new database and returns its UUID.
    [Throws=PinkhaError]
    string create_database(string title);

    /// Returns the full database serialized as JSON (with entries and views).
    [Throws=PinkhaError]
    string get_database_json(string id);

    /// Lists metadata for every active database.
    [Throws=PinkhaError]
    sequence<DatabaseMetaFfi> list_databases();

    /// Replaces the database's rich-text title.
    [Throws=PinkhaError]
    void update_database_title(string id, string new_title);

    /// Replaces or clears the database's cover image.
    [Throws=PinkhaError]
    void update_database_cover(string id, string? cover);

    /// Replaces or clears the database's icon (emoji / file / URL).
    [Throws=PinkhaError]
    void update_database_icon(string id, string? icon);

    /// Replaces the database's rich-text description (empty string clears it).
    [Throws=PinkhaError]
    void update_database_description(string id, string description);

    /// Flips the database's read-only flag.
    [Throws=PinkhaError]
    void update_database_locked(string id, boolean locked);

    /// Soft-deletes the database.
    [Throws=PinkhaError]
    void delete_database(string id);

    /// Soft-deletes every database. Returns the number deleted.
    [Throws=PinkhaError]
    u32 delete_all_databases();

    /// Adds an entry; `values_json` is a serialized UUID -> PropertyValue map.
    [Throws=PinkhaError]
    string add_entry(string db_id, string values_json);

    /// Creates a fresh document and files it as a new row of the database
    /// in one call — fills the hidden page-link column and the Title
    /// column automatically. `values_json` carries any extra column
    /// values (same shape as `add_entry`). Returns the document UUID.
    [Throws=PinkhaError]
    string create_document_in_database(string db_id, string title, string values_json);

    /// Files an existing document as a row of an existing database.
    /// `values_json` is the same UUID -> PropertyValue map as for
    /// `add_entry`. Returns the new entry UUID.
    [Throws=PinkhaError]
    string attach_document_to_database(string db_id, string doc_id, string values_json);

    [Throws=PinkhaError]
    void update_entry(string db_id, string entry_id, string values_json);

    /// Overrides an entry's published_at timestamp.
    /// Empty string = reset to the default (follows created_at).
    [Throws=PinkhaError]
    void update_entry_published_at(string db_id, string entry_id, string new_published_at);

    [Throws=PinkhaError]
    void delete_entry(string db_id, string entry_id);

    /// Restores an entry from its database's trash.
    [Throws=PinkhaError]
    void restore_entry(string db_id, string entry_id);

    /// Permanently deletes a soft-deleted entry (hard delete).
    [Throws=PinkhaError]
    void purge_entry(string db_id, string entry_id);

    /// Lists a database's soft-deleted entries (JSON array).
    [Throws=PinkhaError]
    string list_deleted_entries_json(string db_id);

    /// Lists trashed databases (soft-deleted), most recently deleted first.
    [Throws=PinkhaError]
    sequence<DatabaseMetaFfi> list_deleted_databases();

    /// Restores a database from the trash.
    [Throws=PinkhaError]
    void restore_database(string id);

    /// Permanently deletes a database from the trash (hard delete).
    [Throws=PinkhaError]
    void purge_database(string id);

    /// Adds a property serialized as JSON.
    [Throws=PinkhaError]
    void add_property(string db_id, string property_json);

    [Throws=PinkhaError]
    void rename_property(string db_id, string property_id, string new_name);

    [Throws=PinkhaError]
    void delete_property(string db_id, string property_id);

    /// Adds a view serialized as JSON.
    [Throws=PinkhaError]
    string add_view(string db_id, string view_json);

    [Throws=PinkhaError]
    void update_view(string db_id, string view_id, string filters_json, string sorts_json);

    /// Sets a single sort on a view, replacing any existing ones.
    /// `property_id = null` clears the sort.
    [Throws=PinkhaError]
    void set_view_sort(string db_id, string view_id, string? property_id, boolean ascending);

    /// Sets the view's sort to the entry-level created_at or published_at.
    /// `kind` = "created" or "published". No property_id (the timestamps
    /// live on Entry, not on a column).
    [Throws=PinkhaError]
    void set_view_date_sort(string db_id, string view_id, string kind, boolean ascending);

    [Throws=PinkhaError]
    void delete_view(string db_id, string view_id);

    /// Returns the filtered/sorted entries as JSON.
    [Throws=PinkhaError]
    string query_database_json(string db_id, string view_id);

    /// Returns the filtered/sorted entries with computed rollups as JSON.
    [Throws=PinkhaError]
    string query_database_with_rollups_json(string db_id, string view_id);

    /// Returns the grouped entries as JSON.
    [Throws=PinkhaError]
    string grouped_query_database_json(string db_id, string view_id, string group_by);

    /// Returns a column aggregate as JSON.
    [Throws=PinkhaError]
    string column_aggregate_database_json(string db_id, string property_id, string aggregate_json);

    /// Returns the entries matching the search query as JSON.
    [Throws=PinkhaError]
    string search_database_entries_json(string db_id, string query);

    // ── Folders ───────────────────────────────────────────────

    [Throws=PinkhaError]
    FolderMetaFfi create_folder(string name, string? parent_id);

    [Throws=PinkhaError]
    FolderMetaFfi get_folder(string id);

    [Throws=PinkhaError]
    sequence<FolderMetaFfi> list_folders();

    /// Direct children of `parent_id` (null = root-level folders).
    [Throws=PinkhaError]
    sequence<FolderMetaFfi> list_child_folders(string? parent_id);

    [Throws=PinkhaError]
    void rename_folder(string id, string new_name);

    [Throws=PinkhaError]
    void update_folder_icon(string id, string? icon);

    [Throws=PinkhaError]
    void delete_folder(string id);

    [Throws=PinkhaError]
    u32 delete_all_folders();

    /// Lists trashed folders (soft-deleted), most recently deleted first.
    [Throws=PinkhaError]
    sequence<FolderMetaFfi> list_deleted_folders();

    /// Restores a folder from the trash.
    [Throws=PinkhaError]
    void restore_folder(string id);

    /// Permanently deletes a folder from the trash (hard delete).
    [Throws=PinkhaError]
    void purge_folder(string id);

    [Throws=PinkhaError]
    void move_folder_to(string id, string? new_parent_id);

    [Throws=PinkhaError]
    void move_document_to_folder(string doc_id, string? folder_id);

    [Throws=PinkhaError]
    sequence<DocumentMetaFfi> list_documents_in_folder(string? folder_id);

    /// Sets the parent document (Notion-style nested page). `None` to
    /// promote the document back to the root. Rejects cycles.
    [Throws=PinkhaError]
    void update_document_parent(string doc_id, string? new_parent_doc_id);

    /// Lists root pages (documents with no parent). Drives the home view.
    [Throws=PinkhaError]
    sequence<DocumentMetaFfi> list_root_documents();

    /// Lists the direct children of a parent document (page-in-page).
    [Throws=PinkhaError]
    sequence<DocumentMetaFfi> list_child_documents(string parent_doc_id);

    // ── Imports ───────────────────────────────────────────────

    /// Imports a full Notion database (schema + pages + blocks).
    /// `token` is an OAuth2 bearer token or a private integration token.
    /// `database_id` is a 32-char hex UUID or the full Notion URL.
    ///
    /// Synchronous on the FFI side: Notion uses `reqwest`, which requires a
    /// Tokio runtime that UniFFI's executor does not provide. Rust calls
    /// `block_on`, so Swift must dispatch from `Task.detached` to avoid
    /// blocking the main thread.
    /// `covers_dir` is an absolute path to an existing directory where cover
    /// images are downloaded. When null, only the URL is stored — fine for
    /// external covers but Notion-hosted ones expire after ~1h.
    [Throws=PinkhaError]
    ImportResultFfi import_from_notion(string token, string database_id, string? covers_dir);

    /// Lists the Notion databases reachable with the given token. Used by
    /// the Swift-side picker so the user never has to paste URLs.
    [Throws=PinkhaError]
    sequence<NotionDatabaseSummaryFfi> list_notion_databases(string token);

    /// Same as [`list_notion_databases`] but uses the 2025-09-03
    /// data-source-aware Notion API path under the hood — also catches
    /// the multi-source DBs the legacy filter misses. Pickers should
    /// prefer this version.
    [Throws=PinkhaError]
    sequence<NotionDatabaseSummaryFfi> list_notion_databases_v2025(string token);

    /// Imports Bear notes from Bear's local SQLite database.
    /// `db_path` is the absolute path to Bear's `database.sqlite`.
    [Async, Throws=PinkhaError]
    ImportResultFfi import_from_bear(string db_path);

    /// Imports Craft pages from Craft's local `.realm` file.
    /// `db_path` is the absolute path to Craft's `.realm` file.
    [Async, Throws=PinkhaError]
    ImportResultFfi import_from_craft(string db_path);

    /// Imports Craft pages from a folder of `.textbundle` packages exported by Craft.
    /// `root_dir` is the absolute path to the export's root folder.
    [Async, Throws=PinkhaError]
    ImportResultFfi import_from_craft_textbundle(string root_dir);

    /// Combines Craft's `.realm` file with a folder of `.textbundle` exports:
    /// pages with a matching textbundle use its markdown content;
    /// the remaining pages use the realm content.
    [Async, Throws=PinkhaError]
    ImportResultFfi import_from_craft_combined(string realm_path, string textbundle_root);
};
