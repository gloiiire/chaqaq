namespace pinkha {};

// ── Errors ────────────────────────────────────────────────────────────────────

[Error]
interface PinkhaError {
    NotFound(string id);
    InvalidOperation(string detail);
    Storage(string detail);
};

// ── Returned types ────────────────────────────────────────────────────────────

/// Lightweight leaf metadata (no blocks).
dictionary LeafMetaFfi {
    string id;
    string title_plain;
    string title_json;
    string? cover;
    string updated_at;
    string created_at;
    string published_at;
    string? shelf_id;
    string? parent_leaf_id;
    string? icon;
    string? pinned_at;
    i32? manual_order;
};

/// Lightweight shelf metadata.
dictionary ShelfMetaFfi {
    string id;
    string name;
    string? parent_id;
    string created_at;
    string updated_at;
    string? icon;
    i32? manual_order;
};

/// Lightweight book metadata (no entries).
dictionary BookMetaFfi {
    string id;
    string title_plain;
    string title_json;
    string? cover;
    string? icon;
    string updated_at;
    string created_at;
};

/// One hit from a block-content search — the leaf metadata plus a
/// snippet of the matching block for a Notion-style preview.
dictionary BlockSearchHitFfi {
    LeafMetaFfi doc;
    string block_id;
    string snippet;
};

/// Bundle of search results across every library surface, returned by
/// `super_search`. Empty arrays mean "no match in that category".
dictionary SuperSearchResultsFfi {
    sequence<LeafMetaFfi> leaves_by_title;
    sequence<BlockSearchHitFfi> leaves_by_content;
    sequence<BookMetaFfi> books;
    sequence<ShelfMetaFfi> shelves;
};

/// Summary of a completed import operation, returned to Swift.
dictionary ImportResultFfi {
    string app;
    string book_id;
    u32 leaves;
    u32 entries;
    u32 blocks;
    u32 skipped;
    /// Combined importer only: pages imported via textbundle content (0 otherwise).
    u32 matched_textbundle;
    /// Combined importer only: realm pages with no matching textbundle (0 otherwise).
    u32 realm_fallback;
    /// Combined importer only: textbundles with no matching realm page (0 otherwise).
    u32 textbundle_only;
};

/// Summary of a Notion book returned by `list_notion_databases` for
/// the picker UI.
dictionary NotionDatabaseSummaryFfi {
    string id;
    string title;
    string? icon_emoji;
    string last_edited;
};

// ── Main facade ───────────────────────────────────────────────────────────────

interface PinkhaApi {
    /// Opens (or creates) the SQLite book at the given path.
    [Throws=PinkhaError]
    constructor(string db_path);

    // ── Leaves ─────────────────────────────────────────────

    /// Creates a new leaf and returns its UUID.
    [Throws=PinkhaError]
    string create_leaf(string title);

    /// Returns the full leaf serialized as JSON (with blocks).
    [Throws=PinkhaError]
    string get_leaf_json(string id);

    /// Lists metadata for every active leaf.
    [Throws=PinkhaError]
    sequence<LeafMetaFfi> list_leaves();

    /// Soft-deletes the leaf.
    [Throws=PinkhaError]
    void delete_leaf(string id);

    /// Soft-deletes every leaf. Returns the number deleted.
    [Throws=PinkhaError]
    u32 delete_all_leaves();

    [Throws=PinkhaError]
    void update_leaf_title(string id, string new_title);

    [Throws=PinkhaError]
    void update_leaf_cover(string id, string? cover);

    /// Sets or clears a leaf's icon (emoji, local filename, or URL).
    [Throws=PinkhaError]
    void update_leaf_icon(string id, string? icon);

    /// Enables or disables the read-only lock on a leaf.
    /// Imports (Notion/Bear/Craft) automatically call this with
    /// `locked = true` at creation time.
    [Throws=PinkhaError]
    void update_leaf_locked(string id, boolean locked);

    /// Overrides a leaf's published_at timestamp. Empty string =
    /// reset to the default (follows created_at).
    [Throws=PinkhaError]
    void update_leaf_published_at(string id, string new_published_at);

    /// Pins (true) or unpins (false) a leaf. Pinned leaves surface
    /// in the PINNED section at the top of the library home view.
    [Throws=PinkhaError]
    void set_leaf_pinned(string id, boolean pinned);

    /// Bulk-rewrites the manual sort index for the given leaves :
    /// the first id gets `manual_order = 0`, the next 1, etc.
    /// Pass the leaves in the desired display order.
    [Throws=PinkhaError]
    void set_leaves_manual_order(sequence<string> ordered_ids);

    /// Same shape as `set_leaves_manual_order` but for shelves.
    /// Powers drag-and-drop reorder in the SHELVES sections.
    [Throws=PinkhaError]
    void set_shelves_manual_order(sequence<string> ordered_ids);

    /// Sets or clears the leaf's accent color (per-doc override of
    /// the global accent). Color name ("red", "teal"...) or null to
    /// fall back to the Settings accent.
    [Throws=PinkhaError]
    void update_leaf_accent_color(string id, string? accent_color);

    /// Appends a block; the content is passed as JSON (serialized BlockContent).
    /// Returns the updated leaf as JSON.
    [Throws=PinkhaError]
    string add_block(string leaf_id, string block_content_json);

    /// Replaces the content of an existing block (BlockContent JSON).
    [Throws=PinkhaError]
    void update_block(string leaf_id, string block_id, string content_json);

    /// Sets or clears a block's text color. `color` is a color name
    /// (`"red"`, `"blue"`, etc.) or `null` to revert to the theme.
    /// Inline colors on spans always take priority.
    [Throws=PinkhaError]
    void set_block_color(string leaf_id, string block_id, string? color);

    /// Sets or clears the block's background color (Craft-style highlight).
    [Throws=PinkhaError]
    void set_block_background_color(string leaf_id, string block_id, string? background_color);

    /// Sets or clears the block's writing direction ("ltr" / "rtl").
    /// `null` = inherit from the leaf.
    [Throws=PinkhaError]
    void set_block_text_direction(string leaf_id, string block_id, string? text_direction);

    /// Sets or clears the leaf's default writing direction.
    /// `null` = system locale. Every block can override.
    [Throws=PinkhaError]
    void update_leaf_text_direction(string id, string? text_direction);

    /// Sets or clears the per-leaf theme.
    /// `null` = inherit from AppSettings.theme.
    [Throws=PinkhaError]
    void update_leaf_theme(string id, string? theme);

    [Throws=PinkhaError]
    void delete_block(string leaf_id, string block_id);

    /// Duplicates a block (and all its children, with fresh UUIDs) and
    /// inserts the clone right after the original at the same level.
    /// Returns the new block's UUID.
    [Throws=PinkhaError]
    string duplicate_block(string leaf_id, string block_id);

    /// Reorders the root blocks according to the supplied UUID list.
    [Throws=PinkhaError]
    void reorder_blocks(string leaf_id, sequence<string> order);

    /// Appends a child block; the content is passed as JSON (serialized BlockContent).
    [Throws=PinkhaError]
    string add_child_block(string leaf_id, string parent_id, string block_content_json);

    /// Reorders the direct children of a parent block.
    [Throws=PinkhaError]
    void reorder_child_blocks(string leaf_id, string parent_id, sequence<string> order);

    /// Moves a block under a parent, or to the root when `new_parent_id` is null.
    [Throws=PinkhaError]
    void move_block(string leaf_id, string block_id, string? new_parent_id);

    /// Indents a block: moves it under the previous sibling at the same level.
    /// `InvalidOperation` when the block is the first of its level.
    [Throws=PinkhaError]
    void indent_block(string leaf_id, string block_id);

    /// Outdents a block: moves it out of its parent up to the grandparent
    /// level, right after the former parent. `InvalidOperation` when the
    /// block is already at the root.
    [Throws=PinkhaError]
    void outdent_block(string leaf_id, string block_id);

    /// Case-insensitive search across leaf titles.
    [Throws=PinkhaError]
    sequence<LeafMetaFfi> search_leaves(string query);

    /// Full-text search across block content.
    [Throws=PinkhaError]
    sequence<LeafMetaFfi> search_in_blocks(string query);

    /// Search across book titles.
    [Throws=PinkhaError]
    sequence<BookMetaFfi> search_books(string query);

    /// Full-text search returning a snippet of each matching block.
    [Throws=PinkhaError]
    sequence<BlockSearchHitFfi> search_in_blocks_with_snippets(string query);

    /// Search across shelf names.
    [Throws=PinkhaError]
    sequence<ShelfMetaFfi> search_shelves(string query);

    /// Runs every search axis in one call (titles, block content with
    /// snippets, books, shelves) with the leaf axis deduplicated.
    [Throws=PinkhaError]
    SuperSearchResultsFfi super_search(string query);

    /// Lightweight metadata for a single leaf (no block tree).
    [Throws=PinkhaError]
    LeafMetaFfi get_leaf_meta(string id);

    /// Lists trashed leaves (soft-deleted), most recently deleted first.
    [Throws=PinkhaError]
    sequence<LeafMetaFfi> list_deleted_leaves();

    /// Restores a leaf from the trash.
    [Throws=PinkhaError]
    void restore_leaf(string id);

    /// Permanently deletes a leaf from the trash (hard delete).
    [Throws=PinkhaError]
    void purge_leaf(string id);

    /// Permanently purges every soft-deleted leaf, book and shelf.
    /// Returns the total number of items removed.
    [Throws=PinkhaError]
    u32 empty_trash();

    // ── Books ─────────────────────────────────────────────

    /// Creates a new book and returns its UUID.
    [Throws=PinkhaError]
    string create_book(string title);

    /// Returns the full book serialized as JSON (with entries and views).
    [Throws=PinkhaError]
    string get_book_json(string id);

    /// Lists metadata for every active book.
    [Throws=PinkhaError]
    sequence<BookMetaFfi> list_books();

    /// Replaces the book's rich-text title.
    [Throws=PinkhaError]
    void update_book_title(string id, string new_title);

    /// Replaces or clears the book's cover image.
    [Throws=PinkhaError]
    void update_book_cover(string id, string? cover);

    /// Replaces or clears the book's icon (emoji / file / URL).
    [Throws=PinkhaError]
    void update_book_icon(string id, string? icon);

    /// Replaces the book's rich-text description (empty string clears it).
    [Throws=PinkhaError]
    void update_book_description(string id, string description);

    /// Flips the book's read-only flag.
    [Throws=PinkhaError]
    void update_book_locked(string id, boolean locked);

    /// Soft-deletes the book.
    [Throws=PinkhaError]
    void delete_book(string id);

    /// Soft-deletes the book AND every leaf its rows are backed
    /// by. Returns the number of leaves deleted alongside it.
    [Throws=PinkhaError]
    u32 delete_book_cascade(string id);

    /// Restores a soft-deleted book AND every leaf its rows are
    /// backed by. Returns the number of leaves restored alongside it.
    [Throws=PinkhaError]
    u32 restore_book_cascade(string id);

    /// Soft-deletes every book. Returns the number deleted.
    [Throws=PinkhaError]
    u32 delete_all_books();

    /// Adds an entry; `values_json` is a serialized UUID -> PropertyValue map.
    [Throws=PinkhaError]
    string add_entry(string book_id, string values_json);

    /// Creates a fresh leaf and files it as a new row of the book
    /// in one call — fills the hidden page-link column and the Title
    /// column automatically. `values_json` carries any extra column
    /// values (same shape as `add_entry`). Returns the leaf UUID.
    [Throws=PinkhaError]
    string create_leaf_in_book(string book_id, string title, string values_json);

    /// Files an existing leaf as a row of an existing book.
    /// `values_json` is the same UUID -> PropertyValue map as for
    /// `add_entry`. Returns the new entry UUID.
    [Throws=PinkhaError]
    string attach_leaf_to_book(string book_id, string leaf_id, string values_json);

    [Throws=PinkhaError]
    void update_entry(string book_id, string entry_id, string values_json);

    /// Overrides an entry's published_at timestamp.
    /// Empty string = reset to the default (follows created_at).
    [Throws=PinkhaError]
    void update_entry_published_at(string book_id, string entry_id, string new_published_at);

    [Throws=PinkhaError]
    void delete_entry(string book_id, string entry_id);

    /// Restores an entry from its book's trash.
    [Throws=PinkhaError]
    void restore_entry(string book_id, string entry_id);

    /// Permanently deletes a soft-deleted entry (hard delete).
    [Throws=PinkhaError]
    void purge_entry(string book_id, string entry_id);

    /// Lists a book's soft-deleted entries (JSON array).
    [Throws=PinkhaError]
    string list_deleted_entries_json(string book_id);

    /// Lists trashed books (soft-deleted), most recently deleted first.
    [Throws=PinkhaError]
    sequence<BookMetaFfi> list_deleted_books();

    /// Restores a book from the trash.
    [Throws=PinkhaError]
    void restore_book(string id);

    /// Permanently deletes a book from the trash (hard delete).
    [Throws=PinkhaError]
    void purge_book(string id);

    /// Adds a property serialized as JSON.
    [Throws=PinkhaError]
    void add_property(string book_id, string property_json);

    [Throws=PinkhaError]
    void rename_property(string book_id, string property_id, string new_name);

    [Throws=PinkhaError]
    void delete_property(string book_id, string property_id);

    /// Adds a view serialized as JSON.
    [Throws=PinkhaError]
    string add_view(string book_id, string view_json);

    [Throws=PinkhaError]
    void update_view(string book_id, string view_id, string filters_json, string sorts_json);

    /// Sets a single sort on a view, replacing any existing ones.
    /// `property_id = null` clears the sort.
    [Throws=PinkhaError]
    void set_view_sort(string book_id, string view_id, string? property_id, boolean ascending);

    /// Sets (or clears with null) the Date column that drives every
    /// row's published_at. Adopting backfills all rows and their backing
    /// leaves; clearing resets them to "follow created_at". Returns
    /// the number of rows whose publish date changed.
    [Throws=PinkhaError]
    u32 set_published_at_source(string book_id, string? property_id);

    /// Sets the view's sort to the entry-level created_at or published_at.
    /// `kind` = "created" or "published". No property_id (the timestamps
    /// live on Entry, not on a column).
    [Throws=PinkhaError]
    void set_view_date_sort(string book_id, string view_id, string kind, boolean ascending);

    [Throws=PinkhaError]
    void delete_view(string book_id, string view_id);

    /// Returns the filtered/sorted entries as JSON.
    [Throws=PinkhaError]
    string query_book_json(string book_id, string view_id);

    /// Returns the filtered/sorted entries with computed rollups as JSON.
    [Throws=PinkhaError]
    string query_book_with_rollups_json(string book_id, string view_id);

    /// Returns the grouped entries as JSON.
    [Throws=PinkhaError]
    string grouped_query_book_json(string book_id, string view_id, string group_by);

    /// Returns a column aggregate as JSON.
    [Throws=PinkhaError]
    string column_aggregate_book_json(string book_id, string property_id, string aggregate_json);

    /// Returns the entries matching the search query as JSON.
    [Throws=PinkhaError]
    string search_book_entries_json(string book_id, string query);

    // ── Shelves ───────────────────────────────────────────────

    [Throws=PinkhaError]
    ShelfMetaFfi create_shelf(string name, string? parent_id);

    [Throws=PinkhaError]
    ShelfMetaFfi get_shelf(string id);

    [Throws=PinkhaError]
    sequence<ShelfMetaFfi> list_shelves();

    /// Direct children of `parent_id` (null = root-level shelves).
    [Throws=PinkhaError]
    sequence<ShelfMetaFfi> list_child_shelves(string? parent_id);

    [Throws=PinkhaError]
    void rename_shelf(string id, string new_name);

    [Throws=PinkhaError]
    void update_shelf_icon(string id, string? icon);

    [Throws=PinkhaError]
    void delete_shelf(string id);

    /// Cascade delete : trashes the shelf, every leaf filed inside
    /// it AND every sub-shelf (recursively, with their leaves).
    /// Returns the leaves-deleted count for the confirmation UI.
    [Throws=PinkhaError]
    u32 delete_shelf_cascade(string id);

    [Throws=PinkhaError]
    u32 delete_all_shelves();

    /// Lists trashed shelves (soft-deleted), most recently deleted first.
    [Throws=PinkhaError]
    sequence<ShelfMetaFfi> list_deleted_shelves();

    /// Restores a shelf from the trash.
    [Throws=PinkhaError]
    void restore_shelf(string id);

    /// Permanently deletes a shelf from the trash (hard delete).
    [Throws=PinkhaError]
    void purge_shelf(string id);

    [Throws=PinkhaError]
    void move_shelf_to(string id, string? new_parent_id);

    [Throws=PinkhaError]
    void move_leaf_to_shelf(string leaf_id, string? shelf_id);

    [Throws=PinkhaError]
    sequence<LeafMetaFfi> list_leaves_in_shelf(string? shelf_id);

    /// Sets the parent leaf (Notion-style nested page). `None` to
    /// promote the leaf back to the root. Rejects cycles.
    [Throws=PinkhaError]
    void update_leaf_parent(string leaf_id, string? new_parent_leaf_id);

    /// Lists root pages (leaves with no parent). Drives the home view.
    [Throws=PinkhaError]
    sequence<LeafMetaFfi> list_root_leaves();

    /// Lists the direct children of a parent leaf (page-in-page).
    [Throws=PinkhaError]
    sequence<LeafMetaFfi> list_child_leaves(string parent_leaf_id);

    // ── Imports ───────────────────────────────────────────────

    /// Asks the in-flight import to stop. The import rolls back everything
    /// it created (leaves + book) and returns an "import cancelled"
    /// error. No-op when nothing is running.
    void cancel_import();

    /// Imports a full Notion book (schema + pages + blocks).
    /// `token` is an OAuth2 bearer token or a private integration token.
    /// `book_id` is a 32-char hex UUID or the full Notion URL.
    ///
    /// Synchronous on the FFI side: Notion uses `reqwest`, which requires a
    /// Tokio runtime that UniFFI's executor does not provide. Rust calls
    /// `block_on`, so Swift must dispatch from `Task.detached` to avoid
    /// blocking the main thread.
    /// `covers_dir` is an absolute path to an existing directory where cover
    /// images are downloaded. When null, only the URL is stored — fine for
    /// external covers but Notion-hosted ones expire after ~1h.
    [Throws=PinkhaError]
    ImportResultFfi import_from_notion(string token, string book_id, string? covers_dir);

    /// Lists the Notion books reachable with the given token. Used by
    /// the Swift-side picker so the user never has to paste URLs.
    [Throws=PinkhaError]
    sequence<NotionDatabaseSummaryFfi> list_notion_databases(string token);

    /// Same as [`list_notion_databases`] but uses the 2025-09-03
    /// data-source-aware Notion API path under the hood — also catches
    /// the multi-source DBs the legacy filter misses. Pickers should
    /// prefer this version.
    [Throws=PinkhaError]
    sequence<NotionDatabaseSummaryFfi> list_notion_databases_v2025(string token);

    /// Imports Bear notes from Bear's local SQLite book.
    /// `db_path` is the absolute path to Bear's `book.sqlite`.
    [Async, Throws=PinkhaError]
    ImportResultFfi import_from_bear(string db_path);

    /// Imports Craft pages from Craft's local `.realm` file.
    /// `db_path` is the absolute path to Craft's `.realm` file.
    [Async, Throws=PinkhaError]
    ImportResultFfi import_from_craft(string db_path);

    /// Imports Craft pages from a shelf of `.textbundle` packages exported by Craft.
    /// `root_dir` is the absolute path to the export's root shelf.
    [Async, Throws=PinkhaError]
    ImportResultFfi import_from_craft_textbundle(string root_dir);

    /// Combines Craft's `.realm` file with a shelf of `.textbundle` exports:
    /// pages with a matching textbundle use its markdown content;
    /// the remaining pages use the realm content.
    [Async, Throws=PinkhaError]
    ImportResultFfi import_from_craft_combined(string realm_path, string textbundle_root);
};
