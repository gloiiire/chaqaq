namespace chaqaq {};

// ── Erreurs ───────────────────────────────────────────────────────────────────

[Error]
interface ChaqaqError {
    NonTrouve(string id);
    OperationInvalide(string detail);
    Stockage(string detail);
};

// ── Types retournés ───────────────────────────────────────────────────────────

/// Métadonnées légères d'un document (sans blocs).
dictionary DocumentMetaFfi {
    string id;
    string title_plain;
    string title_json;
    string? cover;
    string updated_at;
    string created_at;
};

/// Métadonnées légères d'une database (sans entrées).
dictionary DatabaseMetaFfi {
    string id;
    string titre_plain;
    string titre_json;
    string updated_at;
    string created_at;
};

// ── Façade principale ─────────────────────────────────────────────────────────

interface ChaqaqApi {
    /// Ouvre (ou crée) la base SQLite au chemin donné.
    [Throws=ChaqaqError]
    constructor(string chemin_db);

    // ── Documents ─────────────────────────────────────────────

    /// Crée un nouveau document et retourne son UUID.
    [Throws=ChaqaqError]
    string creer_document(string titre);

    /// Retourne le document complet sérialisé en JSON (avec blocs).
    [Throws=ChaqaqError]
    string obtenir_document_json(string id);

    /// Liste les métadonnées de tous les documents actifs.
    [Throws=ChaqaqError]
    sequence<DocumentMetaFfi> lister_documents();

    /// Soft-delete du document.
    [Throws=ChaqaqError]
    void supprimer_document(string id);

    [Throws=ChaqaqError]
    void modifier_titre_document(string id, string nouveau_titre);

    [Throws=ChaqaqError]
    void modifier_couverture_document(string id, string? couverture);

    /// Ajoute un bloc ; le contenu est passé en JSON (BlockContent sérialisé).
    /// Retourne le document mis à jour en JSON.
    [Throws=ChaqaqError]
    string ajouter_bloc(string doc_id, string bloc_content_json);

    /// Remplace le contenu d'un bloc existant (JSON de BlockContent).
    [Throws=ChaqaqError]
    void modifier_bloc(string doc_id, string bloc_id, string contenu_json);

    [Throws=ChaqaqError]
    void supprimer_bloc(string doc_id, string bloc_id);

    /// Réordonne les blocs racine selon la liste d'UUIDs fournie.
    [Throws=ChaqaqError]
    void reordonner_blocs(string doc_id, sequence<string> ordre);

    /// Ajoute un bloc enfant ; le contenu est passé en JSON (BlockContent sérialisé).
    [Throws=ChaqaqError]
    string ajouter_bloc_enfant(string doc_id, string parent_id, string bloc_content_json);

    /// Réordonne les enfants directs d'un bloc parent.
    [Throws=ChaqaqError]
    void reordonner_blocs_enfants(string doc_id, string parent_id, sequence<string> ordre);

    /// Déplace un bloc vers un parent ou vers la racine si `nouveau_parent_id` est nul.
    [Throws=ChaqaqError]
    void deplacer_bloc(string doc_id, string bloc_id, string? nouveau_parent_id);

    /// Recherche insensible à la casse dans les titres.
    [Throws=ChaqaqError]
    sequence<DocumentMetaFfi> rechercher_documents(string query);

    /// Recherche plein texte dans les blocs.
    [Throws=ChaqaqError]
    sequence<DocumentMetaFfi> rechercher_dans_blocs(string query);

    // ── Databases ─────────────────────────────────────────────

    /// Crée une nouvelle database et retourne son UUID.
    [Throws=ChaqaqError]
    string creer_database(string titre);

    /// Retourne la database complète sérialisée en JSON (avec entrées et vues).
    [Throws=ChaqaqError]
    string obtenir_database_json(string id);

    /// Liste les métadonnées de toutes les databases actives.
    [Throws=ChaqaqError]
    sequence<DatabaseMetaFfi> lister_databases();

    /// Soft-delete de la database.
    [Throws=ChaqaqError]
    void supprimer_database(string id);

    /// Ajoute une entrée ; `valeurs_json` est une map UUID -> ValeurPropriete sérialisée.
    [Throws=ChaqaqError]
    string ajouter_entree(string db_id, string valeurs_json);

    [Throws=ChaqaqError]
    void modifier_entree(string db_id, string entree_id, string valeurs_json);

    [Throws=ChaqaqError]
    void supprimer_entree(string db_id, string entree_id);

    /// Ajoute une propriété sérialisée en JSON.
    [Throws=ChaqaqError]
    void ajouter_propriete(string db_id, string propriete_json);

    [Throws=ChaqaqError]
    void renommer_propriete(string db_id, string propriete_id, string nouveau_nom);

    [Throws=ChaqaqError]
    void supprimer_propriete(string db_id, string propriete_id);

    /// Ajoute une vue sérialisée en JSON.
    [Throws=ChaqaqError]
    string ajouter_vue(string db_id, string vue_json);

    [Throws=ChaqaqError]
    void modifier_vue(string db_id, string vue_id, string filtres_json, string tris_json);

    [Throws=ChaqaqError]
    void supprimer_vue(string db_id, string vue_id);

    /// Retourne les entrées filtrées/triées en JSON.
    [Throws=ChaqaqError]
    string requete_database_json(string db_id, string vue_id);

    /// Retourne les entrées filtrées/triées avec rollups calculés en JSON.
    [Throws=ChaqaqError]
    string requete_database_avec_rollups_json(string db_id, string vue_id);

    /// Retourne les groupes d'entrées en JSON.
    [Throws=ChaqaqError]
    string requete_groupee_database_json(string db_id, string vue_id, string grouper_par);

    /// Retourne l'agrégat d'une colonne en JSON.
    [Throws=ChaqaqError]
    string agregat_colonne_database_json(string db_id, string propriete_id, string agregat_json);

    /// Retourne les entrées correspondant à la recherche en JSON.
    [Throws=ChaqaqError]
    string rechercher_entrees_database_json(string db_id, string query);
};
