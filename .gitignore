/target
/target.nosync
.DS_Store
.claude/

# Xcode
app/build/
app/*.xcodeproj/xcuserdata/
app/*.xcodeproj/project.xcworkspace/xcuserdata/
# XCFramework : pur artefact de build, reconstruit via build-xcframework.sh.
# On le sort entièrement de git (était partiel : .a gitignored mais headers/plist
# trackés, ce qui causait des diffs spurious à chaque rebuild).
pinkha.xcframework/

# Local secrets injected via xcconfig (Sentry DSN). Template committed as
# Secrets.xcconfig.example. Copy & fill in to set up locally.
app/Config/Secrets.xcconfig

# iCloud Drive conflict copies — files Apple appends " 2", " 3", etc. when
# multiple devices touch the same blob. Should never be tracked.
* [2-9].*
* [2-9]
*[[:space:]][0-9].plist


# SwiftPM-generated per-user Xcode state
**/.swiftpm/xcode/xcuserdata/


# SwiftPM build cache (per-package)
**/.build/

# ── fastlane / CD ────────────────────────────────────────────────────────────
# Secrets and build artefacts produced by fastlane lanes. The
# template `fastlane/.env.example` IS committed ; the populated
# `fastlane/.env` MUST NOT leak (it carries the .p8 content +
# MATCH_PASSWORD).
fastlane/.env
fastlane/.env.*
!fastlane/.env.example

# Build outputs from `build_app` action.
/build/
*.ipa
*.dSYM.zip
*.app.dSYM.zip

# fastlane runtime cruft : logs and reports it drops in the repo root.
fastlane/report.xml
fastlane/README.md
.mcp.json

# Fontes commerciales (Commercial Type) — utilisables en local,
# jamais redistribuables. Cf. utilities/docs/FONT-SUBSTITUTION.md
app/Resources/Fonts/Bundled/
*.ttc
