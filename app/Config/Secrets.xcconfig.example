// Template for app/Config/Secrets.xcconfig. Copy this file to Secrets.xcconfig
// and fill in the real values. The real file is gitignored.
//
//   cp app/Config/Secrets.xcconfig.example app/Config/Secrets.xcconfig
//
// Note: xcconfig interprets `//` as a comment, so URLs in values must escape
// the double slash with `$()` — e.g. https:/$()/example.com/path.

// Sentry DSN for the iOS app (project: apple-ios on the Pinkha-app Sentry org).
// Public on purpose: the DSN ships with every Sentry-instrumented app binary
// and is not a secret. Stored here only to keep the value out of source code.
SENTRY_DSN = https:/$()/your-dsn-here@oXXX.ingest.sentry.io/YYY

// HMAC secret shared with notion-proxy (env var PROXY_HMAC_SECRET on the
// proxy side). Must be identical on both sides. Generate with:
//   openssl rand -hex 32
// Defense-in-depth only — combined with rate-limit and Sentry monitoring on
// the proxy, it raises the cost of abuse without pretending to be a strong
// secret (the binary is decompilable).
PROXY_HMAC_SECRET = replace-with-32-bytes-of-random-hex

// Public HTTPS base URL of the notion-proxy deployment. The app derives both
// `/oauth/callback` (HTTPS redirect URI sent to Notion) and `/oauth/token`
// (token exchange endpoint) from this single value.
// Leave empty until the proxy is deployed — OAuth2 then falls back to the
// "OAuth2 backend proxy is not configured" error and the manual integration
// token flow remains available.
//
// The proxy runs on AWS Lambda behind an API Gateway HTTP API, so the base
// URL looks like https://<api-id>.execute-api.<region>.amazonaws.com.
// The `$()` is not a typo: xcconfig treats `//` as a comment, so the empty
// substitution breaks up the `//` in the scheme and keeps the URL intact.
NOTION_PROXY_URL = https:/$()/your-api-id.execute-api.us-east-1.amazonaws.com

// Public Notion integration client ID. Get it from
// https://www.notion.so/profile/integrations after creating a Public
// integration. Public on purpose (ends up in the OAuth authorize URL),
// stored here just to keep it out of source code so a fresh checkout
// doesn't need a NotionOAuth2.swift edit to wire OAuth up.
NOTION_CLIENT_ID = your-notion-public-integration-client-id
