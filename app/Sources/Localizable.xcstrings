          }
        }
      }
    },
    "Off (default): the app rotates between portrait and landscape with the device. On: stays in portrait whatever the device does — handy on iPhone while reading in bed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off (default): the app rotates between portrait and landscape with the device. On: stays in portrait whatever the device does — handy on iPhone while reading in bed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé (défaut) : l'app pivote entre portrait et paysage avec l'appareil. Activé : reste en portrait quoi qu'il arrive — pratique sur iPhone quand on lit au lit."
          }
        }
      }
    },
